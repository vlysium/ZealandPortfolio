@page "/{category}"
@using ZealandPortfolioLib;
@using ZealandPortfolioLib.Models
@model ZealandPortfolioWeb.Pages.ProjectCategoryModel
@{
	ViewData["BackTo"] = new string[2] { "/Index", "" };
	ViewData["Title"] = Model.ProjectCategory.Name;
}

<section class="project-category-page">
	<nav>
		<ul class="project-category-list">
			@foreach (ProjectCategory projectCategory in Model.ProjectCategories)
			{
			<li>
				<a class="project-category-card @(projectCategory.Slug == Model.ProjectCategory.Slug ? "active" : "")" tabindex="@(projectCategory.Slug == Model.ProjectCategory.Slug ? -1 : 0)" style="--bg-image: url('/assets/images/@projectCategory.Image.Src');" asp-page="/ProjectCategory" asp-route-category="@projectCategory.Slug">
					<span class="project-category-card-title">@projectCategory.Slug</span>
					<span class="project-category-card-counter">@projectCategory.ProjectIds.Count()</span>
				</a>
			</li>
			}
		</ul>
	</nav>

	<h2 class="project-category-page-title">Projekter i @Model.ProjectCategory.Name</h2>

	@if (Model.ProjectCategory.Projects.Count > 0)
	{
	<ul class="project-list">
    @foreach (Project project in Model.ProjectCategory.Projects)
    {
		<li>
			<article class="project-card">
				<div class="project-card-image-wrapper">
					<img class="project-card-image" src="/assets/images/@project.Image.Src" alt="@project.Image.AltText" />
				</div>
				<div class="project-card-content">
					<div class="project-card-title">
						<h3>@project.Name</h3>
						<span>•</span>
						<time datetime="@project.TimeStamp.ToString("yyyy-MM-dd")" title="@project.TimeStamp.ToString("d. MMMM yyyy", new System.Globalization.CultureInfo("da-DK"))">@project.TimeAgo()</time>
					</div>
					<div class="project-card-description-short">
						<p>@project.DescriptionShort</p>
						<a class="stretched-link" asp-page="/ProjectPage" asp-route-category="@Model.ProjectCategory.Slug" asp-route-slug="@project.Slug"></a>
					</div>
					<ul class="project-card-links">
						@if (project.WebsiteLink != null) {
						<li><a class="link icon-left" style="--icon: url('/assets/icons/website.svg')" href="@project.WebsiteLink" target="_blank">Website</a></li>
						}
						@if (project.GithubLink != null) {
						<li><a class="link icon-left" style="--icon: url('/assets/icons/github.svg')" href="@project.GithubLink" target="_blank">GitHub</a></li>
						}
					</ul>
				</div>
			</article>
		</li>
    }
  </ul>
	}
	else
	{
	<div class="project-category-empty-container">
		<p class="project-category-empty-message">Hovsa, denne kategori ser ikke ud til at indeholde nogle projekter endnu. Besøg igen på et senere tidspunkt!</p>
	</div>
	}
</section>
