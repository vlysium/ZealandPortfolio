@page "/{category}"
@using ZealandPortfolioLib.Models
@model ZealandPortfolioWeb.Pages.ProjectCategoryModel
@{
}

<section class="section project-category-page">
	<hgroup class="section-header">
    <h1 class="section-title">@Model.ProjectCategory.Name</h1>
    <p>@Model.ProjectCategory.GetInlineDescription()</p>
  </hgroup>
	<ul class="project-list">
    @foreach (Project project in Model.ProjectCategory.Projects)
    {
		<li>
			<article class="project-card">
				<img class="project-card-image" src="@project.Image.Src" alt="@project.Image.AltText" />
				<div class="project-card-content">
					<h2 class="project-card-title">@project.Name</h2>
					<div class="project-card-description">
						@foreach (string description in project.Description)
						{
						<p>@description</p>
						}
					</div>
				</div>
			</article>
		</li>
    }
  </ul>
</section>
