@page "/{category}"
@using ZealandPortfolioLib.Models
@model ZealandPortfolioWeb.Pages.ProjectCategoryModel
@{
}

<section class="project-category-page">
	<hgroup class="section-header">
    <h1 class="section-title">@Model.ProjectCategory.Name</h1>
    <p>@Model.ProjectCategory.GetInlineDescription()</p>
  </hgroup>

	@if (Model.ProjectCategory.Projects.Count > 0)
	{
	<ul class="project-list">
    @foreach (Project project in Model.ProjectCategory.Projects)
    {
		<li>
			<article class="project-card">
				<img class="project-card-image" src="@project.Image.Src" alt="@project.Image.AltText" />
				<div class="project-card-content">
					<h2 class="project-card-title">@project.Name</h2>
					<ul class="project-card-links">
						<li><a class="link-with-icon" style="--icon: url('/images/website.svg')" href="@project.WebsiteLink" target="_blank">Website</a></li>
						<li><a class="link-with-icon" style="--icon: url('/images/github.svg')" href="@project.GithubLink" target="_blank">GitHub</a></li>
					</ul>
					<div class="project-card-description">
						@foreach (string description in project.Description)
						{
						<p>@description</p>
						}
					</div>
				</div>
			</article>
		</li>
    }
  </ul>
	}
	else
	{
	<div class="project-category-empty-container">
		<p class="project-category-empty-message">Hovsa, denne kategori ser ud til ikke at indeholde nogle projekter endnu. Besøg igen på et senere tidspunkt!</p>
	</div>
	}
</section>
