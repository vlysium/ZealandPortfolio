@{
  string[] backTo = (string[])ViewData["BackTo"]!;
}
<!DOCTYPE html>
<html lang="da">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta robots="noindex, nofollow" />
    <title>@ViewData["Title"] - Zealand Portfolio</title>
    <script type="importmap"></script>
    <script defer src="~/js/script.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/error.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/index.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/project-category.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/project-page.css" asp-append-version="true" />
    <meta property="og:title" content="zealand.vlysium.dev">
    <meta property="og:description" content="Zealand Datamatiker Portfolio Website">
    <meta property="og:url" content="https://zealand.vlysium.dev">
    <meta property="og:type" content="website">
    <meta property="og:image" content="https://zealand.vlysium.dev/assets/images/meta-card-image.webp">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="zealand.vlysium.dev">
    <meta name="twitter:description" content="Zealand Datamatiker Portfolio Website">
    <meta name="twitter:image" content="https://zealand.vlysium.dev/assets/images/meta-card-image.webp">
  </head>
  <body>
    <div class="app">
      <main class="main">
        @if (ViewData["BackTo"] != null)
        {
        <nav class="page-navigation">
          <a class="page-navigation-back" asp-page="@backTo[0]" asp-route-category="@backTo[1]"><span class="sr-only">Tilbage</span></a>
          <h1 class="page-title">@ViewData["Title"]</h1>
          <div class="page-navigation-spacer"></div>
        </nav>
        }
        @RenderBody()
      </main>
    </div>
    <footer class="footer">
      <div class="footer-container">
        <a class="section-title" asp-page="/Index">zealand.vlysium.dev</a>
        <nav class="footer-content">
          <article>
            <p class="footer-subtitle">Links</p>
            <ul class="footer-links">
              <li><a class="link" asp-page="/Index">Hjem</a></li>
              <li><a class="link" asp-page="/Index" asp-fragment="projekter">Projekter</a></li>
              <li><a class="link" asp-page="/Index" asp-fragment="om-mig">Om mig</a></li>
              <li><a class="link" asp-page="/Index" asp-fragment="gæstebog">Gæstebog</a></li>
            </ul>
          </article>
          <article>
            <p class="footer-subtitle">Projekter</p>
            <ul class="footer-links">
              <li><a class="link" asp-page="/ProjectCategory" asp-route-category="swc">Softwarekonstruktion</a></li>
              <li><a class="link" asp-page="/ProjectCategory" asp-route-category="swd">Softwaredesign</a></li>
              <li><a class="link" asp-page="/ProjectCategory" asp-route-category="itf">IT og forretningsforståelse</a></li>
              <li><a class="link" asp-page="/ProjectCategory" asp-route-category="tek">Teknologi</a></li>
            </ul>
          </article>
          <article>
            <p class="footer-subtitle">Kontakt</p>
            <ul class="footer-links">
              <li><a class="link icon-left" style="--icon: url('/assets/icons/github.svg')" href="https://github.com/vlysium" target="_blank">GitHub</a></li>
              <li><a class="link icon-left" style="--icon: url('/assets/icons/email.svg')" href="mailto:vil007@edu.zealand.dk">Email</a></li>
              <li><a class="link icon-left" style="--icon: url('/assets/icons/linkedin.svg')" href="https://www.linkedin.com/in/vlysium" target="_blank">LinkedIn</a></li>
            </ul>
          </article>
          <article>
            <p class="footer-subtitle">Sjove links 😉</p>
            <ul class="footer-links">
              <li><a class="link" asp-page="/Errors/NotFound">404</a></li>
              <li><a class="link" asp-page="/Errors/ImATeapot">418</a></li>
              <li><a class="link" asp-page="/Errors/Error">500</a></li>
            </ul>
          </article>
        </nav>
        <p class="copyright">&copy; @DateTime.Now.Year - Victor Ly</p>
      </div>
    </footer>
    @await RenderSectionAsync("Scripts", required: false)
  </body>
</html>