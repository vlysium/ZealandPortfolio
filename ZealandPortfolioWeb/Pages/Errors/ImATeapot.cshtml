@page "/418"
@model ZealandPortfolioWeb.Pages.Errors.ImATeapotModel
@{
	ViewData["BackTo"] = new string[2] { "/Index", "" };
  ViewData["Title"] = "Serveren nægter at brygge kaffe";
}

<div class="error-container" data-code="418">
	<img class="error-image" src="/assets/illustrations/coffee-with-friends.svg" alt="Ingen projekter" />
	<h1 class="error-title">I'm a teapot</h1>
	<p class="error-message">Øv bøv, serveren nægter at brygge kaffe, fordi den er en tekande. Du kan få lakrids te i en kaffebæger i stedet.</p>
	<div class="error-links">
		<a class="link icon-left" style="--icon: url('/assets/icons/arrow-left.svg')" asp-page="/Index">Tilbage til forsiden</a>
		<span aria-hidden="true">•</span>
		<a class="link" href="https://developer.mozilla.org/en-US/docs/Web/HTTP/Reference/Status/418" target="_blank">418 I'm a teapot</a>
	</div>
</div>
