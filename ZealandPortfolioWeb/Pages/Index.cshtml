@page "/"
@using ZealandPortfolioLib;
@using ZealandPortfolioLib.Models;
@model IndexModel
@{
  ViewData["Title"] = "Forside";
}

<header class="profile">
  <div class="profile-banner">
    <p class="profile-banner-text" aria-hidden="true">zealand.vlysium.dev</p>
    <p class="sr-only">zealand.vlysium.dev</p>
  </div>
  <div class="profile-content">
    <div class="profile-top">
      <div class="profile-picture-wrapper">
        <img class="profile-picture" src="/assets/images/profile-picture.webp" alt="Profilbillede af Victor Ly" />
      </div>
      <ul class="profile-link-list">
        <li>
          <a class="profile-link button button-ghost icon-left" style="--icon: url('/assets/icons/github.svg')" href="https://github.com/vlysium" target="_blank" title="github.com/vlysium">
            <span>GitHub</span>
          </a>
        </li>
        <li>
          <a class="profile-link button button-ghost icon-left" style="--icon: url('/assets/icons/email.svg')" href="mailto:vil007@edu.zealand.dk" title="vil007@edu.zealand.dk">
            <span>Email</span>
          </a>
        </li>
        <li>
          <a class="profile-link button button-ghost icon-left" style="--icon: url('/assets/icons/linkedin.svg')" href="https://www.linkedin.com/in/vlysium" target="_blank" title="linkedin.com/in/vlysium">
            <span>LinkedIn</span>
          </a>
        </li>
      </ul>
    </div>
    <div class="profile-bottom">
      <h1 class="profile-name">Victor Ly</h1>
      <ul class="profile-info">
        <li>Multimediedesigner</li>
        <li aria-hidden="true">•</li>
        <li>Webudvikler</li>
        <li aria-hidden="true">•</li>
        <li>Datamatiker@(Model.DisplayDaysUntilGradiation)</li>
      </ul>
      <blockquote class="profile-quote">
        <p>Fullstack webudvikler med fokus på æstetiske og responsive frontend løsninger, webtilgængelighed og brugeroplevelse.</p>
      </blockquote>
    </div>
  </div>
</header>

<nav class="index-navigation">
  <ul class="index-navigation-list">
    <li><a class="index-navigation-item" href="#projekter">Projekter</a></li>
    <li><a class="index-navigation-item" href="#om-mig">Om mig</a></li>
    <li><a class="index-navigation-item" href="#gæstebog">Gæstebog</a></li>
  </ul>
</nav>

<section id="projekter" class="section project-categories-section">
  <hgroup class="section-header">
    <h2 class="section-title">Projekter</h2>
    <p>Her kan du se et udvalg af mine projekter inden for de forskellige fagområder fra alle semestre.</p>
  </hgroup>
  <ul class="project-category-list">
    @foreach (ProjectCategory projectCategory in Model.ProjectCategories)
    {
    <li>
      <a class="project-category-card" style="--bg-image: url('/assets/images/@projectCategory.Image.Src');" asp-page="/ProjectCategory" asp-route-category="@projectCategory.Slug">
        <h3 class="project-category-card-title">@projectCategory.Slug</h3>
        <span class="project-category-card-counter">@projectCategory.ProjectIds.Count()</span>
      </a>
    </li>
    }
  </ul>
</section>

<section id="om-mig" class="section about-section">
  <h2 class="section-title">Om mig</h2>
  <article>
    <h3 class="section-subtitle">Hvem er jeg?</h3>
    <p>
      <span class="italic">Hello world</span> <span class="waving-hand-emoji">👋</span>, mit navn er Victor, og jeg er @Model.YearsOfAge år gammel.
      Jeg er opvokset på Vesterbro i København og bor i dag i Glostrup.
      Jeg er uddannet multimediedesigner og brænder især for kombinationen af det kreative og det tekniske.
      Det er særligt frontend webudvikling, der fanger min interesse, og jeg synes, det er fedt at kunne tage et design fra idé til et færdigt produkt, som rigtige brugere kan få glæde af.
    </p>
    <p>
      Hvis din <code>CSS</code> driller, så er jeg din <span class="italic">debugger</span>. Du skal dog helst holde dig væk med <code>Bootstrap CSS</code>, for det er jeg allergisk overfor 😭🤧.
    </p>
  </article>
  <article>
    <h3 class="section-subtitle">Min historie</h3>
    <p>
      Det hele startede med ét spørgsmål i folkeskolen: Hvad vil jeg egentlig gerne arbejde med? Svaret var spiludvikling.
      Ligesom mange andre, der elsker at game, var min drøm at udvikle mit eget computerspil.
      Da jeg tog et år på <a class="link" href="https://medieskolen.dk/" target="_blank">Medieskolen Lyngby</a> for at blive klogere på, hvilken uddannelse jeg skulle vælge,
      blev jeg anbefalet at gå multimediedesigner-vejen, da jeg både var glad for at tegne digitalt og arbejde med grafisk design.
    </p>
    <p>
      Efter gymnasiet startede jeg derfor på multimediedesigneruddannelsen på <a class="link" href="https://www.ek.dk/" target="_blank">KEA (nu EK)</a>. Her blev jeg introduceret til webudvikling med <code>HTML</code> og <code>CSS</code>,
      hvilket hurtigt fangede min interesse. Senere stiftede jeg bekendtskab med <code>JavaScript</code>, og det var især muligheden for selv at programmere og skabe interaktive løsninger, der for alvor gjorde mig interesseret i webudvikling.
    </p>
    <p>
      Siden da har jeg arbejdet med udvikling af hjemmesider og webapplikationer og har efterfølgende gennemført et år på top-up-uddannelsen som webudvikler.
      I dag ligger min største interesse inden for frontend, hvor jeg kan kombinere mine kreative evner med min tekniske forståelse.
    </p>
  </article>
  <article>
    <h3 class="section-subtitle">Personlighed</h3>
    <p>
      Jeg er <span class="italic">måske</span> nok som den eneste i klassen, der bruger <code>Docker</code> og <code>nginx</code> til at sætte hjemmesider op på en cloud-server,
      i stedet for bare at smide dem på <a class="link" href="https://www.simply.com/dk/" target="_blank">Simply.com</a> 💀.
      Til gengæld giver det mig muligheden for at køre flere forskellige webapplikationer på den samme server, hvad enten de kører med <code>Node.js</code>, <code>Python</code> eller noget helt tredje, samt have mine egne databaser oppe i skyen.
    </p>
    <p>
      Når jeg ikke sidder og koder, bruger jeg ofte tiden på gaming, tilfældige YouTube-videoer, anime, hobbyprojekter i <code>React</code> eller bare en god omgang doomscrolling på <a class="link" href="https://www.reddit.com/" target="_blank">Reddit</a>.
      Jeg interesserer mig også for lingvistik, matematik og naturvidenskab og synes, det er fascinerende at lære mere om, hvordan verden omkring os hænger sammen.
    </p>
    <p>
      Jeg har også en kat ved navn <span class="italic">Cookie</span>, som jeg har haft siden maj 2026.
      Hun er en rigtig legesyg kat og kan være lidt crazy, når hun får zoomies, men hun er samtidig utrolig kærlig og elsker at putte og følge os rundt i huset. 🐱
    </p>
    <p>
      Nåh ja... fik jeg egentlig nævnt, at jeg <span class="italic">ikke</span> kan lide <code>Bootstrap CSS</code>? 😭🙏
    </p>
  </article>
</section>

<section id="gæstebog" class="section comments-section">
  <hgroup class="section-header">
    <h2 class="section-title">Gæstebog</h2>
    <p>Har du lyst til at dele en tanke, give lidt feedback på hjemmesiden eller bare sige hej? Klik på knappen nedenfor og læg en lille besked i gæstebogen - det ville være hyggeligt at høre fra dig! 😊</p>
  </hgroup>

  <button class="button button-primary icon-right" style="--icon: url('/assets/icons/pencil.svg')" type="button" command="show-modal" commandfor="comment-popup">Skriv en besked</button>
  <dialog id="comment-popup" class="comment-popup">
    <form class="comment-form" method="post">
      @Html.AntiForgeryToken()
      <div class="comment-form-body">
        <div class="comment-form-author-wrapper">
          <label class="comment-form-author-label" for="comment-form-author">Afsender:</label>
          <input id="comment-form-author" type="text" placeholder="Dit navn" minlength="1" maxlength="20" asp-for="UserComment.Author" required />
        </div>
        <div class="comment-form-message-wrapper">
          <textarea id="comment-form-message" placeholder="Del dine tanker..." minlength="1" maxlength="200" asp-for="UserComment.Message" required></textarea>
          <span class="comment-form-message-max" data-maxlength="200">0</span>
        </div>
      </div>
      <div class="comment-form-footer">
        <span class="comment-form-error-message" asp-validation-summary="All"></span>
        <div class="comment-form-actions">
          <button class="button button-primary icon-right" style="--icon: url('/assets/icons/send.svg')" type="submit" disabled>Send</button>
          <button class="button button-ghost" type="button" command="close" commandfor="comment-popup">Annuller</button>
        </div>
      </div>
    </form>
  </dialog>

  <h3 class="comment-list-title">Seneste 10 beskeder</h3>

  <template id="comment-card-template">
    <li>
      <article class="comment-card new">
        <div class="comment-card-avatar">
          <div class="comment-card-initial">[Initial]</div>
        </div>
        <span class="comment-card-header">
          <p class="comment-card-author">[Author]</p>
          <span>•</span>
          <time class="comment-card-datetime" datetime="[DateTime]" title="[Title]">[TimeAgo]</time>
        </span>
        <p class="comment-card-message">[Message]</p>
      </article>
    </li>
  </template>

  <ul class="comment-list">
    @foreach (Comment comment in Model.Latest10Comments)
    {
    <li>
      <article class="comment-card">
        <div class="comment-card-avatar">
          <div class="comment-card-initial">@comment.GetInitial()</div>
        </div>
        <span class="comment-card-header">
          <p class="comment-card-author">@comment.Author</p>
          <span>•</span>
          <time class="comment-card-time" datetime="@comment.CreatedAt.ToString("yyyy-MM-ddTHH:mm")" title="@comment.CreatedAt.ToString("d. MMMM yyyy", new System.Globalization.CultureInfo("da-DK"))">@comment.TimeAgo()</time>
        </span>
        <p class="comment-card-message">@comment.Message</p>
      </article>
    </li>
    }
  </ul>
</section>
