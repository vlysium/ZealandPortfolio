@page "/"
@using ZealandPortfolioLib;
@model IndexModel
@{
  ViewData["Title"] = "Home page";
}

<header class="profile">
  <div class="profile-top">
    <img class="profile-picture" src="~/images/avatar.webp" alt="Profilbillede af Victor Ly" />
    <hgroup class="profile-info">
      <h1 class="profile-name">Victor Ly</h1>
      <p>Datamatiker@(Model.DisplayDaysUntilGradiation)</p>
      <p>Webudvikler</p>
      <p>Multimediedesigner</p>
    </hgroup>
  </div>
  <div class="profile-bottom">
    <blockquote class="profile-quote">
      <p>Fullstack webudvikler med stor interesse og fokus på responsive frontend løsninger, webtilgængelighed og brugeroplevelse.</p>
    </blockquote>
    <ul class="profile-link-list">
      <li>
        <a class="link-with-icon" style="--icon: url('/images/github.svg')" href="https://github.com/vlysium" target="_blank">github.com/vlysium</a>
      </li>
      <li>
        <a class="link-with-icon" style="--icon: url('/images/email.svg')" href="mailto:vil007@edu.zealand.dk">vil007@edu.zealand.dk</a>
      </li>
      <li>
        <a class="link-with-icon" style="--icon: url('/images/website.svg')" href="https://portfolio.vlysium.dev" target="_blank">portfolio.vlysium.dev</a>
      </li>
    </ul>
  </div>
</header>

<section id="project-categories" class="section project-categories-section">
  <hgroup class="section-header">
    <h2 class="section-title">Projekter</h2>
    <p>Her kan du se mine projekter inden for de forskellige fagområder.</p>
  </hgroup>
  <ul class="project-category-list">
    @foreach (ProjectCategory projectCategory in Model.ProjectCategories)
    {
    <li>
      <a class="project-category-card" style="--bg-image: url('@projectCategory.Image.Src');" asp-page="/ProjectCategory" asp-route-category="@projectCategory.Slug">
        <h3 class="project-category-card-title">@projectCategory.Slug</h3>
        <span class="project-category-card-counter">@projectCategory.ProjectIds.Count()</span>
      </a>
    </li>
    }
  </ul>
</section>
